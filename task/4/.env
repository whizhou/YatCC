# myllm 配置 — 复制为 .env 后填入实际值: cp .env.example .env
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
TASK4_LLM_BIN=./build/task/4/task4-llm
TASK4_CLASSIC_BIN=./build/task/4/task4-classic
AGENT_TEMPERATURE=0.0
AGENT_MAX_TOKENS=8192
AGENT_MAX_ITERATIONS=5
AGENT_CONVERGENCE_THRESHOLD=0.5
